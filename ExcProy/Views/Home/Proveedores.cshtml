
@{
    ViewBag.Title = "Proveedores";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Proveedores</h2>

<div class="card">
    <div class="card-header">
        <i class="fas fa-box me-1"></i>Proveedores
    </div>
    <table id="tabla" class="table table-sm" style="width: 100%">
        <thead>
            <tr>
                <th>Orgnización</th>
                <th>Nombres</th>
                <th>Apellidos</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>

    <hr />

    <div class="card-body">
        <div class="row">
            <div class="col-12">
                <button type="button" class="btn" style="background-color: #BF3B3B; color:white;" onclick="abrirModal(null)">Crear Nuevo</button>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="formModal" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #BF3B3B; color:white">
                <h5 class="modal-title">Proveedor</h5>
                <button type="button" class="btn" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row g-2">
                    <input id="txtId" type="hidden" value="0">
                    <div class="col-sm-6">
                        <label for="txtNombreORG" class="form-label">Organización</label>
                        <input type="text" class="form-control" id="txtNombreORG" autocomplete="off">
                    </div>
                    <div class="col-sm-6">
                        <label for="txtNombres" class="form-label">Nombres</label>
                        <input type="text" class="form-control" id="txtNombres" autocomplete="off">
                    </div>
                    <div class="col-sm-6">
                        <label for="txtApellidos" class="form-label">Apellidos</label>
                        <input type="text" class="form-control" id="txtApellidos" autocomplete="off">
                    </div>
                    <div class="row mt-2">
                        <div class="col-12">
                            <div id="alertError" class="alert alert-danger" role="alert">No deberías poder ver esto :)</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" style="background-color: #BF3B3B; color:white" onclick="guardar()">
                    Guardar
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        var tabladata;
        var selectedRow;

        tabladata = $("#tabla").DataTable({
            responsive: true,
            ordering: false,
            "ajax": {
                url: '@Url.Action("ListarProveedores", "Home")',
                type: "GET",
                datatype: "json"
            },
            "columns": [
                { "data": "nombreORG" },
                { "data": "nombres" },
                { "data": "apellidos" },
                {
                    "defaultContent": '<button type="button" class="btn btn-primary btn-sm btn-editar"><i class="fas fa-pen"></i></button>' +
                        '<button type="button" class="btn btn-danger btn-sm ms-2 btn-eliminar"><i class="fas fa-trash"></i></button>',
                    "orderable": false,
                    "searchable": false,
                    "width": "100px"
                }
            ],
            "language": {
                "url": "//cdn.datatables.net/plug-ins/2.3.2/i18n/es-ES.json"
            }
        });

        function abrirModal(json) {
            $("#txtId").val(0);
            $("#txtNombreORG").val("");
            $("#txtNombres").val("");
            $("#txtApellidos").val("");
            $("#alertError").hide();
            if (json != null) {
                $("#txtId").val(json.idProveedor);
                $("#txtNombreORG").val(json.nombreORG);
                $("#txtNombres").val(json.nombres);
                $("#txtApellidos").val(json.apellidos);
            }
            $("#formModal").modal("show");
        }

        $("#tabla tbody").on("click", ".btn-editar", function () {
            selectedRow = $(this).closest("tr")
            var data = tabladata.row(selectedRow).data();
            abrirModal(data)
        })

        $("#tabla tbody").on("click", ".btn-eliminar", function () {
            var selectedProvider = $(this).closest("tr")
            var data = tabladata.row(selectedProvider).data();

            Swal.fire({
                title: "¿Está seguro?",
                text: "¿Desea eliminar al proveedor?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Si, estoy seguro",
                cancelButtonText: "Cancelar"
            }).then((result) => {
                if (result.isConfirmed) {
                        jQuery.ajax({
                            url: '@Url.Action("EliminarProveedor", "Home")',
                            type: "POST",
                            data: JSON.stringify({ id : data.idProveedor }),
                            dataType: "json",
                            contentType: "application/json; charset=utf-8",
                            success: function (data) {
                                if (data.resultado) {
                                    tabladata.row(selectedProvider).remove().draw();
                                    Swal.fire({
                                        title: "Proveedor eliminado",
                                        text: "El proveedor ha sido eliminado",
                                        icon: "success"
                                    });
                                } else {
                                    Swal.fire(data.mensaje)
                                }
                            },
                            error: function (error) {
                                console.log(error);
                                Swal.fire({
                                    title: "Error del servidor",
                                    text: "No se puede eliminar el proveedor",
                                    icon: "error"
                                })
                            }
                        });

                }
            });
        })

        function guardar() {
            var Proveedor = {
                idProveedor: $("#txtId").val(),
                nombres: $("#txtNombres").val(),
                apellidos: $("#txtApellidos").val(),
                nombreORG: $("#txtNombreORG").val()
            }

            jQuery.ajax({
                url: '@Url.Action("GuardarProveedor", "Home")',
                type: "POST",
                data: JSON.stringify({ obj : Proveedor }),
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    $(".modal-body").LoadingOverlay("hide");
                    //crear proveedor
                    if (Proveedor.idProveedor == 0) {
                        if (data.resultado != 0) {
                            Proveedor.idProveedor = data.resultado;
                            tabladata.row.add(Proveedor).draw(false);
                            $("#formModal").modal("hide");
                        } else {
                            $("#alertError").text(data.mensaje);
                            $("#alertError").show();
                        }
                    }
                    //editar proveedor
                    else {
                        if (data.resultado) {
                            tabladata.row(selectedRow).data(Proveedor).draw(false);
                            selectedRow = null;
                            $("#formModal").modal("hide");
                        } else {
                            $("#alertError").text(data.mensaje);
                            $("#alertError").show();
                        }
                    }
                },
                error: function (error) {
                    $(".modal-body").LoadingOverlay("hide");
                    $("#alertError").text("Error AJAX");
                    $("#alertError").show();
                },
                beforeSend: function () {
                    $(".modal-body").LoadingOverlay("show", {
                        imageResizeFactor: 2,
                        text: "Cargando...",
                        size: 14
                    })
                }
            });
        }
    </script>
}
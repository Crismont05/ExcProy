
@{
    ViewBag.Title = "Inventario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Gestión de ingreso y egreso de productos</h2>
<div class="card">
    <div class="card-header">
        <i class="fas fa-square-caret-left"></i>Entradas de producto
    </div>
    <div class="card-body">
        <table id="tabla1" class="table table-sm" style="width: 100%">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Fecha de ingreso</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>

        <hr />
        <div class="row">
            <div class="col-12">
                <button type="button" class="btn" style="background-color: #BF3B3B; color:white;" onclick="abrirModalEnt(null)">Nueva entrada</button>
            </div>
        </div>
    </div>
</div>
<div class="card">
    <div class="card-header">
        <i class="fas fa-right-from-bracket"></i>Salidas de producto
    </div>
    <div class="card-body">
        <table id="tabla2" class="table table-sm" style="width: 100%">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Fecha de egreso</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>

        <hr />
        <div class="row">
            <div class="col-12">
                <button type="button" class="btn" style="background-color: #BF3B3B; color:white;" onclick="abrirModalSal(null)">Nueva salida</button>
            </div>
        </div>
    </div>
</div>
<div class="card">
    <div class="card-header">
        <i class="fas fa-box me-1"></i>Inventario
    </div>

    <div class="card-body">
        <table id="tabla3" class="table table-sm" style="width: 100%">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Existencia</th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>

<div class="modal" id="formModalEnt" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #BF3B3B; color:white">
                <h5 class="modal-title">Ingreso de producto</h5>
                <button type="button" class="btn" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row g-2">
                    <input id="txtIdEnt" type="hidden" value="0" />
                    <div class="col-sm-6">
                        <label for="cboProductoEnt" class="form-label">Producto</label>
                        <select id="cboProductoEnt" class="form-select">
                            @*Se llena dinámicamente*@
                            <option value="" disabled selected>Seleccione</option>
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <label for="txtCantidadEnt" class="form-label">Cantidad</label>
                        <input type="text" class="form-control" id="txtCantidadEnt" autocomplete="off" />
                    </div>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-12">
                    <div id="alertErrorEnt" class="alert alert-danger" role="alert">No deberías poder ver esto :)</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" style="background-color: #BF3B3B; color:white" onclick="guardarEnt()">
                    Guardar
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="formModalSal" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #BF3B3B; color:white">
                <h5 class="modal-title">Egreso de producto</h5>
                <button type="button" class="btn" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row g-2">
                    <input id="txtIdSal" type="hidden" value="0" />
                    <div class="col-sm-6">
                        <label for="cboProductoSal" class="form-label">Producto</label>
                        <select id="cboProductoSal" class="form-select">
                            @*Se llena dinámicamente*@
                            <option value="" disabled selected>Seleccione</option>
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <label for="txtCantidadSal" class="form-label">Cantidad</label>
                        <input type="text" class="form-control" id="txtCantidadSal" autocomplete="off" />
                    </div>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-12">
                    <div id="alertErrorSal" class="alert alert-danger" role="alert">No deberías poder ver esto :)</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" style="background-color: #BF3B3B; color:white" onclick="guardarSal()">
                    Guardar
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        var tabladata1;
        var tabladata2;
        var tabladata3;
        var selectedRow;
        var listProducts;

        $(document).ready(function () {
            $.ajax({
                url: '@Url.Action("ListarProductos", "Home")',
                type: "GET",
                datatype: "json",
                success: function (resultado) {
                    listProducts = resultado.data;
                }
            });
        });

        function actualizarEntrada() {
            tabladata1.ajax.reload(null, false);
        }

        function actualizarSalida() {
            tabladata2.ajax.reload(null, false);
        }

        function actualizarExistencia() {
            tabladata3.ajax.reload(null, false);
        }

        tabladata1 = $("#tabla1").DataTable({
            responsive: true,
            ordering: false,
            "ajax": {
                url: '@Url.Action("ListarEntradas", "Home")',
                type: "GET",
                datetype: "json"
            },
            "columns": [
                {
                    "data": "idProducto",
                    "render": function (data, type, row) {
                        var producto = listProducts.find(p => p.idProducto == data);
                        return producto ? producto.nombre : '';
                    }
                },
                { "data": "cantidad" },
                {
                    "data": "fecha",
                    /*Formateo a fecha dd/mm/yyyy hr:min Diabolico*/
                    "render": function (data, type, row) {
                        if (!data) return '';
                        var timestamp = parseInt(data.replace(/\/Date\((\d+)\)\//, "$1"));
                        var date = new Date(timestamp);
                        var day = ('0' + date.getDate()).slice(-2);
                        var month = ('0' + (date.getMonth() + 1)).slice(-2);
                        var year = date.getFullYear();
                        var hours = ('0' + date.getHours()).slice(-2);
                        var minutes = ('0' + date.getMinutes()).slice(-2);
                        return `${day}/${month}/${year} ${hours}:${minutes}`;
                    }
                },
                {
                    "defaultContent": '<button type="button" class="btn btn-primary btn-sm btn-editarEnt"><i class="fas fa-pen"></i></button>' +
                        '<button type="button" class="btn btn-danger btn-sm ms-2 btn-eliminarEnt"><i class="fas fa-trash"></i></button>',
                    "orderable": false,
                    "searchable": false,
                    "width": "100px"
                }
            ],
            "language": {
                "url": "//cdn.datatables.net/plug-ins/2.3.2/i18n/es-ES.json"
            }
        });

        tabladata2 = $("#tabla2").DataTable({
            responsive: true,
            ordering: false,
            "ajax": {
                url: '@Url.Action("ListarSalidas", "Home")',
                type: "GET",
                datetype: "json"
            },
            "columns": [
                {
                    "data": "idProducto",
                    "render": function (data, type, row) {
                        var producto = listProducts.find(p => p.idProducto == data);
                        return producto ? producto.nombre : '';
                    }
                },
                { "data": "cantidad" },
                {
                    "data": "fecha",
                    /*Formateo a fecha dd/mm/yyyy hr:min Diabolico*/
                    "render": function (data, type, row) {
                        if (!data) return '';
                        var timestamp = parseInt(data.replace(/\/Date\((\d+)\)\//, "$1"));
                        var date = new Date(timestamp);
                        var day = ('0' + date.getDate()).slice(-2);
                        var month = ('0' + (date.getMonth() + 1)).slice(-2);
                        var year = date.getFullYear();
                        var hours = ('0' + date.getHours()).slice(-2);
                        var minutes = ('0' + date.getMinutes()).slice(-2);
                        return `${day}/${month}/${year} ${hours}:${minutes}`;
                    }
                },
                {
                    "defaultContent": '<button type="button" class="btn btn-primary btn-sm btn-editarSal"><i class="fas fa-pen"></i></button>' +
                        '<button type="button" class="btn btn-danger btn-sm ms-2 btn-eliminarSal"><i class="fas fa-trash"></i></button>',
                    "orderable": false,
                    "searchable": false,
                    "width": "100px"
                }
            ],
            "language": {
                "url": "//cdn.datatables.net/plug-ins/2.3.2/i18n/es-ES.json"
            }
        });

        tabladata3 = $("#tabla3").DataTable({
            responsive: true,
            ordering: false,
            "ajax": {
                url: '@Url.Action("ListarExistencias", "Home")',
                type: "GET",
                datatype: "json"
            },
            "columns": [
                {
                    "data": "idProducto",
                    "render": function (data, type, row) {
                        var producto = listProducts.find(p => p.idProducto == data);
                        return producto ? producto.nombre : '';
                    }
                },
                { "data": "stock" },
            ],
            "language": {
                "url": "//cdn.datatables.net/plug-ins/2.3.2/i18n/es-ES.json"
            }
        });

        function abrirModalEnt(json) {
            var productosIds = [...new Set(listProducts.map(x => x.idProducto))];
            var productos = productosIds.map(id => {
                var prod = listProducts.find(p => p.idProducto == id);
                return prod ? { id: prod.idProducto, nombre: prod.nombre } : { id: id, nombre: id };
            });

            var $cboProductoEnt = $("#cboProductoEnt");
            $cboProductoEnt.empty();
            $cboProductoEnt.append('<option value="">Selecione</option>');
            productos.forEach(function (prod) {
                $cboProductoEnt.append($('<option>', { value: prod.id, text: prod.nombre }))
            });

            $("#cboProductoEnt").val("");
            $("#txtCantidadEnt").val("");
            $("#alertErrorEnt").hide();
            if (json != null) {
                $("#cboProductoEnt").val(json.idProducto);
                $("#txtCantidadEnt").val(json.cantidad);
            }
            $("#formModalEnt").modal("show");
        }

        $("#tabla1 tbody").on("click", ".btn-editarEnt", function () {
            selectedRow = $(this).closest("tr")
            var data = tabladata1.row(selectedRow).data();
            abrirModalEnt(data)
        });

        $("#tabla1 tbody").on("click", ".btn-eliminarEnt", function () {
            selectedIn = $(this).closest("tr")
            var data = tabladata1.row(selectedIn).data();

            Swal.fire({
                title: "¿Está seguro?",
                text: "¿Desea eliminar esta entrada?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Si, estoy seguro",
                cancelButtonText: "Cancelar"
            }).then((result) => {
                if (result.isConfirmed) {
                    jQuery.ajax({
                        url: '@Url.Action("EliminarEntrada", "Home")',
                        type: "POST",
                        data: JSON.stringify({ id : data.idEntrada }),
                        dataType: "json",
                        contentType: "application/json; charset=utf-8",
                        success: function (data) {
                            if (data.resultado) {
                                tabladata1.row(selectedIn).remove().draw();
                                actualizarExistencia();
                                actualizarEntrada();
                                Swal.fire({
                                    title: "Entrada eliminada",
                                    text: "La entrada ha sido eliminada",
                                    icon: "success"
                                });
                            } else {
                                Swal.fire(data.mensaje)
                            }
                        },
                        error: function (error) {
                            console.log(error);
                            Swal.fire({
                                title: "Error del servidor",
                                text: "No se puede eliminar la entrada",
                                icon: "error"
                            })
                        }
                    });
                }
            });
        });

        function abrirModalSal(json) {
            var productosIds = [...new Set(listProducts.map(x => x.idProducto))];
            var productos = productosIds.map(id => {
                var prod = listProducts.find(p => p.idProducto == id);
                return prod ? { id: prod.idProducto, nombre: prod.nombre } : { id: id, nombre: id };
            });

            var $cboProductoSal = $("#cboProductoSal");
            $cboProductoSal.empty();
            $cboProductoSal.append('<option value="">Selecione</option>');
            productos.forEach(function (prod) {
                $cboProductoSal.append($('<option>', { value: prod.id, text: prod.nombre }))
            });

            $("#cboProductoSal").val("");
            $("#txtCantidadSal").val("");
            $("#alertErrorSal").hide();
            if (json != null) {
                $("#cboProductoSal").val(json.idProducto);
                $("#txtCantidadSal").val(json.cantidad);
            }
            $("#formModalSal").modal("show");
        }

        $("#tabla2 tbody").on("click", ".btn-editarSal", function () {
            selectedRow = $(this).closest("tr")
            var data = tabladata2.row(selectedRow).data();
            abrirModalEnt(data)
        });

        $("#tabla2 tbody").on("click", ".btn-eliminarSal", function () {
            selectedOut = $(this).closest("tr")
            var data = tabladata2.row(selectedOut).data();

            Swal.fire({
                title: "¿Está seguro?",
                text: "¿Desea eliminar esta entrada?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Si, estoy seguro",
                cancelButtonText: "Cancelar"
            }).then((result) => {
                if (result.isConfirmed) {
                    jQuery.ajax({
                        url: '@Url.Action("EliminarSalida", "Home")',
                        type: "POST",
                        data: JSON.stringify({ id : data.idSalida }),
                        dataType: "json",
                        contentType: "application/json; charset=utf-8",
                        success: function (data) {
                            if (data.resultado) {
                                tabladata2.row(selectedOut).remove().draw();
                                actualizarExistencia();
                                actualizarSalida();
                                Swal.fire({
                                    title: "Salida eliminada",
                                    text: "La salida ha sido eliminada",
                                    icon: "success"
                                });
                            } else {
                                Swal.fire(data.mensaje)
                            }
                        },
                        error: function (error) {
                            console.log(error);
                            Swal.fire({
                                title: "Error del servidor",
                                text: "No se puede eliminar la entrada",
                                icon: "error"
                            })
                        }
                    });
                }
            });
        });

        function guardarEnt() {
            var Entrada = {
                idEntrada: $("#txtIdEnt").val(),
                idInventario: 1,
                idProducto: $("#cboProductoEnt").val(),
                cantidad: $("#txtCantidadEnt").val()
            };

            jQuery.ajax({
                 url: '@Url.Action("GuardarEntrada", "Home")',
                 type: "POST",
                 data: JSON.stringify({ obj : Entrada }),
                 dataType: "json",
                 contentType: "application/json; charset=utf-8",
                 success: function (data) {
                     $(".modal-body").LoadingOverlay("hide");
                     //crear producto
                     if (Entrada.idEntrada == 0) {
                         if (data.resultado != 0) {
                             Entrada.idEntrada = data.resultado;
                             tabladata1.row.add(Entrada).draw(false);
                             actualizarExistencia();
                             actualizarEntrada();
                             $("#formModalEnt").modal("hide");
                         } else {
                             $("#alertErrorEnt").text(data.mensaje);
                             $("#alertErrorEnt").show();
                         }
                     }
                     //editar producto
                     else {
                         if (data.resultado) {
                             tabladata1.row(selectedRow).data(Entrada).draw(false);
                             actualizarExistencia();
                             actualizarEntrada();
                             actualizarSalida();
                             selectedRow = null;
                             $("#formModalEnt").modal("hide");
                         } else {
                             $("#alertErrorEnt").text(data.mensaje);
                             $("#alertErrorEnt").show();
                         }
                     }
                 },
                 error: function (error) {
                     $(".modal-body").LoadingOverlay("hide");
                     $("#alertErrorEnt").text("Error AJAX");
                     $("#alertErrorEnt").show();
                 },
                 beforeSend: function () {
                     $(".modal-body").LoadingOverlay("show", {
                         imageResizeFactor: 2,
                         text: "Cargando...",
                         size: 14
                     })
                 }
             });
        }

        function guardarSal() {
            var Salida = {
                idSalida: $("#txtIdSal").val(),
                idInventario: 1,
                idProducto: $("#cboProductoSal").val(),
                cantidad: $("#txtCantidadSal").val()
            };

            jQuery.ajax({
                 url: '@Url.Action("GuardarSalida", "Home")',
                 type: "POST",
                 data: JSON.stringify({ obj : Salida }),
                 dataType: "json",
                 contentType: "application/json; charset=utf-8",
                 success: function (data) {
                     $(".modal-body").LoadingOverlay("hide");
                     //crear producto
                     if (Salida.idSalida == 0) {
                         if (data.resultado != 0) {
                             Salida.idSalida = data.resultado;
                             tabladata2.row.add(Salida).draw(false);
                             actualizarExistencia();
                             actualizarSalida();
                             $("#formModalSal").modal("hide");
                         } else {
                             $("#alertErrorSal").text(data.mensaje);
                             $("#alertErrorSal").show();
                         }
                     }
                     //editar producto
                     else {
                         if (data.resultado) {
                             tabladata2.row(selectedRow).data(Salida).draw(false);
                             actualizarExistencia();
                             actualizarSalida();
                             selectedRow = null;
                             $("#formModalSal").modal("hide");
                         } else {
                             $("#alertErrorSal").text(data.mensaje);
                             $("#alertErrorSal").show();
                         }
                     }
                 },
                 error: function (error) {
                     $(".modal-body").LoadingOverlay("hide");
                     $("#alertErrorSal").text("Error AJAX");
                     $("#alertErrorSal").show();
                 },
                 beforeSend: function () {
                     $(".modal-body").LoadingOverlay("show", {
                         imageResizeFactor: 2,
                         text: "Cargando...",
                         size: 14
                     })
                 }
             });
        }
    </script>
}
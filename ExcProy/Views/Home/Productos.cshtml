
@{
    ViewBag.Title = "Productos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Productos</h2>

<div class="card">
    <div class="card-header">
        <i class="fas fa-box me-1"></i>Productos
    </div>
    <table id="tabla" class="table table-sm" style="width: 100%">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Precio</th>
                <th>Categoria</th>
                <th>Proveedor</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>

    <hr />

    <div class="card-body">
        <div class="row">
            <div class="col-12">
                <button type="button" class="btn" style="background-color: #BF3B3B; color:white;" onclick="abrirModal(null)">Crear Nuevo</button>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="formModal" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #BF3B3B; color:white">
                <h5 class="modal-title">Producto</h5>
                <button type="button" class="btn" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row g-2">
                    <input id="txtId" type="hidden" value="0">
                    <div class="col-sm-6">
                        <label for="txtNombre" class="form-label">Nombre</label>
                        <input type="text" class="form-control" id="txtNombre" autocomplete="off">
                    </div>
                    <div class="col-sm-6">
                        <label for="txtPrecio" class="form-label">Precio</label>
                        <input type="text" class="form-control" id="txtPrecio" autocomplete="off">
                    </div>
                    <div class="col-sm-6">
                        <div class="col-sm-6">
                            <label for="txtCategoria" class="form-label">Categoria</label>
                            <input type="text" class="form-control" id="txtCategoria" autocomplete="off">
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label for="cboProveedor" class="form-label">Proveedor</label>
                        <select id="cboProveedor" class="form-select">
                            @*Se llena dinámicamente*@
                            <option value="" disabled selected>Seleccione</option>
                        </select>
                    </div>
                    <div class="row mt-2">
                        <div class="col-12">
                            <div id="alertError" class="alert alert-danger" role="alert">No deberías poder ver esto :)</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" style="background-color: #BF3B3B; color:white" onclick="guardar()">
                    Guardar
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        var tabladata;
        var selectedRow;
        var listProviders;

        $(document).ready(function () {
            $.ajax({
                url: '@Url.Action("ListarProveedores", "Home")',
                type: "GET",
                datatype: "json",
                success: function (resultado) {
                    listProviders = resultado.data;
                }
            });
        }); 

        tabladata = $("#tabla").DataTable({
            responsive: true,
            ordering: false,
            "ajax": {
                url: '@Url.Action("ListarProductos", "Home")',
                type: "GET",
                datatype: "json"
            },
            "columns": [
                { "data": "nombre" },
                { "data": "precio" },
                { "data": "categoria" },
                {
                    "data": "idProveedor",
                    "render": function (data, type, row) {
                        var proveedor = listProviders.find(p => p.idProveedor == data);
                        return proveedor ? proveedor.nombreORG : '';
                    }
                },
                {
                    "defaultContent": '<button type="button" class="btn btn-primary btn-sm btn-editar"><i class="fas fa-pen"></i></button>' +
                        '<button type="button" class="btn btn-danger btn-sm ms-2 btn-eliminar"><i class="fas fa-trash"></i></button>',
                    "orderable": false,
                    "searchable": false,
                    "width": "100px"
                }
            ],
            "language": {
                "url": "//cdn.datatables.net/plug-ins/2.3.2/i18n/es-ES.json"
            }
        });

        function abrirModal(json) {
            var proveedoresIds = [...new Set(listProviders.map(x => x.idProveedor))];
            var proveedores = proveedoresIds.map(id => {
                var prov = listProviders.find(p => p.idProveedor == id);
                return prov ? { id: prov.idProveedor, nombre: prov.nombreORG } : { id: id, nombre: id };
            });

            var $cboProveedor = $("#cboProveedor");
            $cboProveedor.empty();
            $cboProveedor.append('<option value="">Selecione</option>');
            proveedores.forEach(function (prov) {   
                $cboProveedor.append($('<option>', { value: prov.id, text: prov.nombre }))
            });

            $("#txtId").val(0);
            $("#txtNombre").val("");
            $("#txtPrecio").val(0);
            $("#txtCategoria").val("");
            $("#cboProveedor").val("");
            $("#alertError").hide();
            if (json != null) {
                $("#txtId").val(json.idProducto);
                $("#txtNombre").val(json.nombre);
                $("#txtPrecio").val(json.precio);
                $("#txtCategoria").val(json.categoria);
                $("#cboProveedor").val(json.idProveedor);
            }
            $("#formModal").modal("show");
        }

        $("#tabla tbody").on("click", ".btn-editar", function () {
            selectedRow = $(this).closest("tr")
            var data = tabladata.row(selectedRow).data();
            abrirModal(data)
        })

        $("#tabla tbody").on("click", ".btn-eliminar", function () {
            var selectedProduct = $(this).closest("tr")
            var data = tabladata.row(selectedProduct).data();

            Swal.fire({
                title: "¿Está seguro?",
                text: "¿Desea eliminar el producto?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Si, estoy seguro",
                cancelButtonText: "Cancelar"
            }).then((result) => {
                if (result.isConfirmed) {
                        jQuery.ajax({
                            url: '@Url.Action("EliminarProducto", "Home")',
                            type: "POST",
                            data: JSON.stringify({ id : data.idProducto }),
                            dataType: "json",
                            contentType: "application/json; charset=utf-8",
                            success: function (data) {
                                if (data.resultado) {
                                    tabladata.row(selectedProduct).remove().draw();
                                    Swal.fire({
                                        title: "Producto eliminado",
                                        text: "El producto ha sido eliminado",
                                        icon: "success"
                                    });
                                } else {
                                    Swal.fire(data.mensaje)
                                }
                            },
                            error: function (error) {
                                console.log(error);
                                Swal.fire({
                                    title: "Error del servidor",
                                    text: "No se puede eliminar el producto",
                                    icon: "error"
                                })
                            }
                        });

                }
            });
        })
        function guardar() {
            var precioValor = parseFloat($("#txtPrecio").val().replace(',', '.'));
            if (isNaN(precioValor)) {
                $("#alertError").text("El precio debe ser un número válido");
                $("#alertError").show();
                return;
            }

            if ($("#cboProveedor").val() == "") {
                $("#alertError").text("Debe seleccionar un proveedor");
                $("#alertError").show();
                return;
            }

            var Producto = {
                idProducto: $("#txtId").val(),
                nombre: $("#txtNombre").val(),
                precio: precioValor, // Aquí ya es decimal
                categoria: $("#txtCategoria").val(),
                idProveedor: $("#cboProveedor").val()
            };

            jQuery.ajax({
                url: '@Url.Action("GuardarProducto", "Home")',
                type: "POST",
                data: JSON.stringify({ obj : Producto }),
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    $(".modal-body").LoadingOverlay("hide");
                    //crear producto
                    if (Producto.idProducto == 0) {
                        if (data.resultado != 0) {
                            Producto.idProducto = data.resultado;
                            tabladata.row.add(Producto).draw(false);
                            $("#formModal").modal("hide");
                        } else {
                            $("#alertError").text(data.mensaje);
                            $("#alertError").show();
                        }
                    }
                    //editar producto
                    else {
                        if (data.resultado) {
                            tabladata.row(selectedRow).data(Producto).draw(false);
                            selectedRow = null;
                            $("#formModal").modal("hide");
                        } else {
                            $("#alertError").text(data.mensaje);
                            $("#alertError").show();
                        }
                    }
                },
                error: function (error) {
                    $(".modal-body").LoadingOverlay("hide");
                    $("#alertError").text("Error AJAX");
                    $("#alertError").show();
                },
                beforeSend: function () {
                    $(".modal-body").LoadingOverlay("show", {
                        imageResizeFactor: 2,
                        text: "Cargando...",
                        size: 14
                    })
                }
            });
        }
    </script>
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.ExclusivoInv</title>
    <script src="https://kit.fontawesome.com/d3ab8ed5b3.js" crossorigin="anonymous"></script>
    @Styles.Render("~/Content/Site.css")
    @Styles.Render("~/Content/css")
    @*@Scripts.Render("~/bundles/modernizr")*@
    @{
        var RolUsuario = Session["rol"] as string;
    }

</head>
<body class="sb-nav-fixed">
    <nav class="sb-topnav navbar navbar-expand navbar-dark bg-dark">
        <!-- Navbar Brand-->

        <!-- Sidebar Toggle-->
        <button class="btn btn-link btn-sm order-1 order-lg-0 me-4 me-lg-0" id="sidebarToggle" href="#!"><i class="fas fa-bars"></i></button>
        <!-- Navbar Search-->
        @*<form class="d-none d-md-inline-block form-inline ms-auto me-0 me-md-3 my-2 my-md-0">
            <div class="input-group">
                <input class="form-control" type="text" placeholder="Buscar..." aria-label="Buscar..." aria-describedby="btnNavbarSearch" />
                <button class="btn btn-primary" id="btnNavbarSearch" type="button"><i class="fas fa-search"></i></button>
            </div>
        </form>*@
        <!-- Navbar-->
        <ul class="navbar-nav ms-auto me-0 me-md-3 my-2 my-md-0">
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" id="navbarDropdown" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="fas fa-user fa-fw"></i></a>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item" href="@Url.Action("Index", "Acceso")">Cerrar sesión</a></li>
                </ul>
            </li>
        </ul>
    </nav>
    <div id="layoutSidenav">
        <div id="layoutSidenav_nav">
            <nav class="sb-sidenav accordion sb-sidenav-dark" id="sidenavAccordion">
                <div class="sb-sidenav-menu">
                    <center>
                        <img src="https://www.absalonstore.com/cdn/shop/files/ABSALON_STORE_180x.png?v=1729082922" alt="Absalón Store Logo" class="sidebar-logo">
                    </center>
                    <div class="nav">
                        <div class="sb-sidenav-menu-heading " style="color:#78807D70">BI</div>
                        <a class="nav-link" href="@Url.Action("Index","Home")">
                            <div class="sb-nav-link-icon"><i class="fas fa-tachometer-alt" style="color:#78807D70"></i></div>
                            <span style="color: #78807D;">Dashboard</span>
                        </a>
                        <div class="sb-sidenav-menu-heading " style="color:#78807D70">Inventariado</div>
                        <a class="nav-link" href="@Url.Action("Inventario","Home")">
                            <div class="sb-nav-link-icon"><i class="fas fa-boxes-packing" style="color:#78807D70"></i></div>
                            <span style="color: #78807D;">Inventario</span>
                        </a>

                        @if (RolUsuario == "admin")
                        {
                        <div class="sb-sidenav-menu-heading " style="color:#78807D70">Admin</div>
                        <a class="nav-link" href="@Url.Action("Usuarios", "Home")">
                            <div class="sb-nav-link-icon"><i class="fas fa-users" style="color:#78807D70"></i></div>
                            <span style="color: #78807D;">Usuarios</span>
                        </a>
                        <a class="nav-link" href="@Url.Action("Proveedores", "Home")">
                            <div class="sb-nav-link-icon"><i class="fas fa-truck" style="color:#78807D70"></i></div>
                            <span style="color: #78807D;">Proveedores</span>
                        </a>
                        <a class="nav-link" href="@Url.Action("Productos", "Home")">
                            <div class="sb-nav-link-icon"><i class="fas fa-box" style="color:#78807D70"></i></div>
                            <span style="color: #78807D;">Productos</span>
                        </a>
                        }
                    </div>
                </div>
            </nav>
        </div>
        <div id="layoutSidenav_content">
            <main>
                <div class="container-fluid px-4">
                    @RenderBody()
                </div>
            </main>

        </div>
    </div>


    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/complementos")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>

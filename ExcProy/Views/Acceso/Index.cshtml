@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
    <link href="~/Content/Styles.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
    
        <div class="header-bar"></div>

        <div class="login-container">
            <div class="logo-section">
                <img src="https://www.absalonstore.com/cdn/shop/files/ABSALON_STORE_180x.png?v=1729082922" alt="Absalón Store Logo">
            </div>
            <div class="login-form-section">
                <div class="user-icon-large">
                    <i class="fa-solid fa-circle-user fa-2x" style="color: #2a2a2a !important;"></i>
                </div>
                <form class="login-form" action="@Url.Action("Index","Acceso")" method="post">
                    <div class="input-group">
                        <label for="username">Usuario</label>
                        <input type="text" name="usuario" required autocomplete="off">
                    </div>
                    <div class="input-group">
                        <label for="password">Contraseña</label>
                        <input type="password" name="clave" required>
                    </div>
                    <button type="submit" class="login-button">Iniciar sesión</button>
                </form>
            </div>
            
        </div>
       
    
    <footer>
        <p>&copy; @DateTime.Now.Year - Exclusivo APP</p>
    </footer>
    
</body>
</html>